{
  "name": "rocket-launch-scene",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Single-file Three.js rocket launch scene (rocket-launch.html) plus dev-only verification tooling. No build step and no runtime dependencies: the product is one self-contained HTML file.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "three.js",
    "rocket-launch",
    "webgl",
    "single-file"
  ],
  "scripts": {
    "dev": "node tools/serve.mjs",
    "serve": "node tools/serve.mjs",
    "start": "node tools/serve.mjs",
    "test": "node tools/verify.mjs",
    "verify": "node tools/verify.mjs",
    "verify:all": "node tools/verify.mjs",
    "verify:static": "node tools/verify-static.mjs",
    "verify:browser": "node tools/verify-browser.mjs",
    "verify:browser:mirror": "node tools/verify-browser.mjs --mirror",
    "verify:readback": "node tools/check-canvas-readback.mjs"
  }
}
